# Smart Factory - Redirect to Clean Site Directory

<IfModule mod_rewrite.c>
RewriteEngine On

# SSL Redirect (keeping existing)
RewriteCond %{HTTP:CF-Visitor} '"scheme":"http"'
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# GD-SSL (keeping existing)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_USER_AGENT} ^(.+)$
RewriteCond %{SERVER_NAME} ^www\.smartfactory\.io$ [OR]
RewriteCond %{SERVER_NAME} ^h8p\.480\.myftpupload\.com$
RewriteRule .* https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

# Redirect everything to /site/ directory EXCEPT already /site/ requests
RewriteCond %{REQUEST_URI} !^/site/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ /site/$1 [R=301,L]

# Handle root domain - redirect to site
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /site/ [R=301,L]

</IfModule>

Header add Strict-Transport-Security "max-age=300"
Header always set Content-Security-Policy "upgrade-insecure-requests"