{
  "name": "@smartfactory/wandavision-react",
  "version": "0.1.0",
  "description": "React bindings for WandaVision Universal Intelligence - Live content editing system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@smartfactory/wandavision-core": "workspace:*",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.294.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/node": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "cms",
    "content-management", 
    "universal-editor",
    "ai-powered",
    "smart-factory"
  ]
}